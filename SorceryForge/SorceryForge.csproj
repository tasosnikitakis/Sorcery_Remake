<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================
       SORCERY FORGE — ROOM EDITOR
       Sibling MonoGame app that shares the main game's source files via
       <Compile Include> globs. Same rendering engine, same data types,
       same content pipeline.
       ======================================== -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Nullable>enable</Nullable>
    <RootNamespace>SorceryForge</RootNamespace>
    <AssemblyName>SorceryForge</AssemblyName>
    <!-- ONE pointer write needs this: ImGui's io.IniFilename is a raw char*
         with no managed setter, and we set it to null so the editor never
         drops an imgui.ini beside the source tree. See UI/ImGuiRenderer.cs.
         Nothing else in this project is unsafe, and nothing else should be. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The editor lives in its own bin/ tree but reads/writes JSON in the
         repo's assets/data/. The auto-detection in EditorPaths walks up
         from the executable until it finds the repo root. -->
  </PropertyGroup>

  <!-- ========================================
       MONOGAME FRAMEWORK
       ======================================== -->

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>

  <!-- ========================================
       DEAR IMGUI — EDITOR CHROME ONLY
       The repo's one non-MonoGame dependency, and it is deliberately scoped
       to this project: the GAME must never gain it. See the dependency
       policy note in .claude/CLAUDE.md.

       ImGui.NET is the raw binding (cimgui + a generated C# surface), NOT a
       MonoGame integration package. The MonoGame wrappers on NuGet were all
       surveyed and all rejected — see the header of UI/ImGuiRenderer.cs for
       which ones and why. What they would have supplied, the ~450 lines of
       UI/ImGuiRenderer.cs supplies instead, against a version that actually
       ships a net8.0 target.

       PINNED EXACTLY. ImGui's C# surface is generated from cimgui and moves
       with it; a float-range change to a widget signature between minor
       versions is normal. A floating version would let a `dotnet restore`
       months from now break a build nobody touched.
       ======================================== -->

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <!-- ========================================
       SHARED SOURCE (compiled into the editor)
       Pulls in the same Core/Graphics/Tiles/Rooms/Doors/Physics types the
       main game uses. We exclude PlayerController.cs because it is gameplay
       input, not data. Enemies/* aren't included — the editor doesn't run
       enemy AI, just renders them.
       ======================================== -->

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Exclude="..\Core\PlayerController.cs" />
    <Compile Include="..\Graphics\**\*.cs" />
    <Compile Include="..\Tiles\**\*.cs" />
    <Compile Include="..\Rooms\**\*.cs" />
    <Compile Include="..\Doors\**\*.cs" />
    <Compile Include="..\Physics\**\*.cs" />
  </ItemGroup>

  <!-- ========================================
       CONTENT PIPELINE
       Reuses the main game's .mgcb file. Assets are copied into the
       editor's own bin/Content output by MonoGame.Content.Builder.Task.
       ======================================== -->

  <ItemGroup>
    <MonoGameContentReference Include="..\Content\Content.mgcb" />
  </ItemGroup>

  <!-- ========================================
       ASSETS/DATA
       Mirror collision JSONs into the editor's output so it can render
       collision overlays. Saved content_*.json files are written back
       to the source path (resolved via EditorPaths.RepoAssetsDataDir).
       ======================================== -->

  <ItemGroup>
    <Content Include="..\assets\data\*.json">
      <Link>assets\data\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
